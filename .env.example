# --- Database (Supabase/Neon PostgreSQL) ---
DATABASE_URL="postgresql://user:password@host:PORT/postgres?pgbouncer=true"
DIRECT_URL="postgresql://user:password@host:PORT/postgres"

# --- Telegram (bot notifications + /api/telegram/webhook) ---
# Token from @BotFather. Used server-side to send notifications, verify the
# webhook signature, and re-verify the Telegram Login Widget signature during
# registration/login. The numeric prefix must match the widget bot id below.
TELEGRAM_BOT_TOKEN="123456789:AAE..."
# The Login Widget bot is PINNED to @Quizplatbot / 8769306244 in
# src/lib/config.ts. The two NEXT_PUBLIC_* vars below are NOT read by the
# build (kept only for documentation); override them only if you intentionally
# repoint the platform at a different bot.
NEXT_PUBLIC_TELEGRAM_BOT_ID="8769306244"
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME="Quizplatbot"
# Telegram user id that should receive admin notifications.
TELEGRAM_ADMIN_ID="123456789"
# Optional links shown in the UI.
TELEGRAM_CHANNEL_URL="https://t.me/your_channel"
TELEGRAM_GROUP_URL="https://t.me/your_group"
NEXT_PUBLIC_TELEGRAM_CHANNEL_URL="https://t.me/your_channel"
NEXT_PUBLIC_TELEGRAM_GROUP_URL="https://t.me/your_group"
# If set, the /api/telegram/webhook route requires a matching X-Telegram-Bot-Api-Secret-Token header.
TELEGRAM_WEBHOOK_SECRET=""

# --- NextAuth ---
NEXTAUTH_SECRET="generate-a-long-random-string"
NEXTAUTH_URL="https://YOUR_DOMAIN"

# --- App ---
# Public site URL (used in Telegram bot messages, e.g. the /start reply).
APP_URL="https://YOUR_DOMAIN"

# --- Seed Admin ---
ADMIN_USERNAME="admin"
ADMIN_NAME="Platform Admin"
ADMIN_PASSWORD="ChangeMe123!"

# --- Groq AI (optional) ---
GROQ_API_KEY="gsk_..."