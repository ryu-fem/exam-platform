# ============================================
# Exam Platform - Environment Variables
# ============================================
# Copy this file to `.env` and fill in your own values.

# --- Database (Neon PostgreSQL) ---
# Get a free database from https://neon.tech
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"
DIRECT_URL="postgresql://user:password@host/db?sslmode=require"

# --- NextAuth ---
# Generate a random secret: openssl rand -base64 32
NEXTAUTH_SECRET="your-random-secret-here"
NEXTAUTH_URL="http://localhost:3000"

# --- App ---
APP_URL="http://localhost:3000"

# --- Telegram Bot ---
# Create a bot via @BotFather on Telegram
TELEGRAM_BOT_TOKEN="your-bot-token-here"
TELEGRAM_ADMIN_ID="your-telegram-id-here"
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME="YourBotUsername"

# --- Telegram Channel & Group ---
TELEGRAM_CHANNEL_URL="https://t.me/your_channel"
TELEGRAM_GROUP_URL="https://t.me/your_group"
NEXT_PUBLIC_TELEGRAM_CHANNEL_URL="https://t.me/your_channel"
NEXT_PUBLIC_TELEGRAM_GROUP_URL="https://t.me/your_group"

# --- Groq AI ---
# Get a free API key from https://console.groq.com
GROQ_API_KEY="your-groq-api-key-here"

# --- Seed Admin (optional) ---
ADMIN_USERNAME="admin"
ADMIN_NAME="Platform Admin"
ADMIN_PASSWORD="ChangeMe123!"
