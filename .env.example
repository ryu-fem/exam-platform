# --- Database (Neon PostgreSQL) ---
# Get a connection string from https://neon.tech
# For Vercel/Neon serverless, you may need the pooled connection (add ?sslmode=require&pgbouncer=true)
DATABASE_URL="postgresql://user:password@ep-example.region.aws.neon.tech/exam-platform?sslmode=require"

# --- Telegram ---
# Create a bot with @BotFather and paste the token.
TELEGRAM_BOT_TOKEN="123456789:AAEexample_token_here"
# Numeric admin chat id (message @userinfobot to find yours, or use the bot /start)
TELEGRAM_ADMIN_ID="123456789"

# --- Public links (replace with your real invite links) ---
TELEGRAM_CHANNEL_URL="https://t.me/your_channel_link"
TELEGRAM_GROUP_URL="https://t.me/your_group_link"

# --- NextAuth ---
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="change-me-to-a-long-random-string"
NEXTAUTH_URL="http://localhost:3000"

# --- Groq (AI dashboard features) ---
# Get a free API key from https://console.groq.com/keys
GROQ_API_KEY="gsk_your_groq_api_key_here"
# Optional: override the default model (defaults to llama3-8b-8192, falls back to llama-3.1-8b-instant)
# GROQ_MODEL="llama3-8b-8192"

# --- App ---
# Public base URL of the web app (used to build onboarding links)
APP_URL="http://localhost:3000"
# Public bot username (must start with a letter, e.g. MyExamBot)
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME="MyExamBot"
NEXT_PUBLIC_TELEGRAM_CHANNEL_URL="https://t.me/your_channel"
NEXT_PUBLIC_TELEGRAM_GROUP_URL="https://t.me/your_group"

# Seed (optional) — used by `npm run db:seed` to create the first admin
ADMIN_USERNAME="admin"
ADMIN_NAME="Platform Admin"
ADMIN_PASSWORD="ChangeMe123!"
